# ==============================================================================
# StackSignal Backend Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Options: 'gemini' (default) or 'mock' (offline demo mode, no API key required)
LLM_PROVIDER=gemini

# Google Gemini API Key (Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Gemini Model Name
GEMINI_MODEL=gemini-2.5-flash

# GitHub Personal Access Token (Optional)
GITHUB_TOKEN=

# Embedding Model (Sentence Transformers run locally)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Server & Storage Configuration
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=data/stacksignal.db
CHROMA_PERSIST_DIR=data/chroma
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
