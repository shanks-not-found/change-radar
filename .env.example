# ==============================================================================
# StackSignal Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Options: 'gemini' (default) or 'mock' (offline demo mode, no API key required)
LLM_PROVIDER=gemini

# Google Gemini API Key (Required if LLM_PROVIDER=gemini)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Model Name (e.g., gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# GitHub Personal Access Token (Optional, raises rate limit from 60/hr to 5000/hr)
GITHUB_TOKEN=

# Embedding Model (Sentence Transformers run locally)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Server & Storage Configuration
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=backend/data/stacksignal.db
CHROMA_PERSIST_DIR=backend/data/chroma

# Frontend Configuration
VITE_API_URL=http://localhost:8000
